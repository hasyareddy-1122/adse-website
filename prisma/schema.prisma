// Prisma schema — SQLite does not support enums, so Role / Status values
// are stored as strings and validated at the application layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles: SUPER_ADMIN | ADMIN (HOD) | FACULTY | STUDENT
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?
  name         String
  role         String   @default("STUDENT")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  facultyProfile FacultyProfile?
  taughtSubjects Subject[]       @relation("SubjectTeacher")
  documents      Document[]
  contentEdits   SiteContent[]
  statusesGiven  StudentStatus[] @relation("StatusReviewer")
  ownStatuses    StudentStatus[] @relation("StatusOwner")
  invitations    Invitation[]
}

// Email-based invitations used by ADMIN/SUPER_ADMIN to onboard
// faculties (and admins) — the invite is bound to an email address.
model Invitation {
  id          Int       @id @default(autoincrement())
  email       String
  name        String
  role        String // FACULTY | ADMIN
  token       String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdById Int
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

// Public-facing faculty directory entries (seeded from faculty.json).
// Optionally linked to a User account with role FACULTY.

model FacultyProfile {
  id             Int     @id @default(autoincrement())
  name           String
  department     String  @default("AI, ML AND DATA SCIENCE")
  specialization String?
  image          String?
  userId         Int?    @unique
  user           User?   @relation(fields: [userId], references: [id])

  designation    String?
  qualification  String?
  bio            String?
  publicEmail    String?
  researchGate   String?
  googleScholar  String?
  orcid          String?
  website        String?
  cabinLocation  String?
}


model ClassSection {
  id        Int       @id @default(autoincrement())
  name      String    @unique // e.g. "III Semester - Section A"
  createdAt DateTime  @default(now())
  subjects  Subject[]
}

model Subject {
  id             Int          @id @default(autoincrement())
  title          String
  code           String       @unique
  classSectionId Int
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)
  teacherId      Int?
  teacher        User?        @relation("SubjectTeacher", fields: [teacherId], references: [id])
  documents      Document[]

  @@index([teacherId])
}

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  fileName     String // original name
  storedName   String   @unique // name on disk inside uploads/
  mimeType     String
  sizeBytes    Int
  isPublic     Boolean  @default(true)
  subjectId    Int
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  uploadedById Int
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([subjectId])
}

// Key/value store so the SUPER_ADMIN can mutate text/data rendered on
// the public pages without a redeploy.
model SiteContent {
  key         String   @id
  value       String // JSON-encoded payload
  updatedById Int?
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
  updatedAt   DateTime @updatedAt
}

// Status items students track for themselves; only FACULTY/ADMIN/
// SUPER_ADMIN may create or update them.
model StudentStatus {
  id          Int      @id @default(autoincrement())
  studentId   Int
  student     User     @relation("StatusOwner", fields: [studentId], references: [id], onDelete: Cascade)
  title       String // e.g. "Project Phase-1 review"
  status      String   @default("PENDING") // PENDING | IN_PROGRESS | APPROVED | REJECTED | COMPLETED
  remark      String?
  updatedById Int?
  reviewer    User?    @relation("StatusReviewer", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([studentId])
}
